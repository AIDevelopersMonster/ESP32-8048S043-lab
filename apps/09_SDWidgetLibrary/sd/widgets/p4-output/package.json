{
  "schema": 1,
  "id": "p4-output",
  "name": "P4 Output",
  "version": "0.1.0",
  "type": "widget-package",
  "entrypoints": [
    {
      "id": "outputs",
      "name": "GPIO17 / GPIO18 Outputs",
      "file": "outputs.json"
    }
  ],
  "requires": {
    "minimum_platform": "0.3.8",
    "services": [
      "p4-gpio"
    ]
  },
  "hardware": {
    "connector": "P4",
    "outputs": ["GPIO17", "GPIO18"],
    "logic": "3.3V"
  },
  "firmware": {
    "required": true
  },
  "secrets": {
    "storage": "none",
    "sd_allowed": true
  }
}
