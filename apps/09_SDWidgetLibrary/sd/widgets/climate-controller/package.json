{
  "schema": 1,
  "id": "climate-controller",
  "name": "Climate Controller",
  "version": "0.1.0",
  "type": "widget-package",
  "entrypoints": [
    {
      "id": "home",
      "name": "Climate Controller",
      "file": "home.json"
    },
    {
      "id": "settings",
      "name": "Climate Limits",
      "file": "settings.json"
    }
  ],
  "requires": {
    "minimum_platform": "0.3.9",
    "services": [
      "climate",
      "modbus"
    ]
  },
  "firmware": {
    "required": true
  },
  "secrets": {
    "storage": "none",
    "sd_allowed": true
  }
}
