{
  "schema": 1,
  "id": "usb-serial-terminal.advanced",
  "name": "Advanced Serial Terminal",
  "version": "0.4.0",
  "background": "#0B1016",
  "objects": [
    {
      "type": "label",
      "x": 16,
      "y": 4,
      "w": 310,
      "h": 26,
      "text": "ADVANCED SERIAL TERMINAL",
      "color": "#F0F6FC"
    },
    {
      "type": "label",
      "x": 340,
      "y": 4,
      "w": 388,
      "h": 26,
      "bind": "serial.state",
      "color": "#58A6FF"
    },
    {
      "type": "label",
      "x": 16,
      "y": 32,
      "w": 180,
      "h": 24,
      "bind": "serial.tx_mode",
      "prefix": "MODE: ",
      "color": "#D2A8FF"
    },
    {
      "type": "label",
      "x": 204,
      "y": 32,
      "w": 180,
      "h": 24,
      "bind": "serial.ending",
      "prefix": "ENDING: ",
      "color": "#FFA657"
    },
    {
      "type": "label",
      "x": 392,
      "y": 32,
      "w": 336,
      "h": 24,
      "bind": "serial.last_tx",
      "prefix": "LAST: ",
      "color": "#8B949E"
    },
    {
      "type": "label",
      "x": 16,
      "y": 60,
      "w": 712,
      "h": 116,
      "bind": "serial.rx_text",
      "prefix": "RX > ",
      "color": "#7EE787"
    },
    {
      "type": "textarea",
      "id": "tx_input",
      "x": 16,
      "y": 182,
      "w": 516,
      "h": 44,
      "placeholder": "Tap to edit ASCII or HEX bytes",
      "max_length": 128,
      "one_line": true,
      "color": "#F0F6FC"
    },
    {
      "type": "button",
      "x": 544,
      "y": 182,
      "w": 86,
      "h": 44,
      "text": "SEND",
      "action": "serial_send_text",
      "target": "tx_input",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 640,
      "y": 182,
      "w": 88,
      "h": 44,
      "text": "CLEAR",
      "action": "serial_clear",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 16,
      "y": 234,
      "w": 88,
      "h": 34,
      "text": "ASCII",
      "action": "serial_mode_ascii",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 112,
      "y": 234,
      "w": 72,
      "h": 34,
      "text": "HEX",
      "action": "serial_mode_hex",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 194,
      "y": 234,
      "w": 82,
      "h": 34,
      "text": "NONE",
      "action": "serial_ending_none",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 284,
      "y": 234,
      "w": 62,
      "h": 34,
      "text": "LF",
      "action": "serial_ending_lf",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 354,
      "y": 234,
      "w": 62,
      "h": 34,
      "text": "CR",
      "action": "serial_ending_cr",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 424,
      "y": 234,
      "w": 82,
      "h": 34,
      "text": "CRLF",
      "action": "serial_ending_crlf",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 516,
      "y": 234,
      "w": 98,
      "h": 34,
      "text": "PREV",
      "action": "serial_history_prev",
      "target": "tx_input",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 622,
      "y": 234,
      "w": 106,
      "h": 34,
      "text": "NEXT",
      "action": "serial_history_next",
      "target": "tx_input",
      "color": "#FFFFFF"
    },
    {
      "type": "button",
      "x": 16,
      "y": 278,
      "w": 156,
      "h": 34,
      "text": "REPEAT LAST",
      "action": "serial_repeat_last",
      "color": "#FFFFFF"
    },
    {
      "type": "label",
      "x": 188,
      "y": 284,
      "w": 178,
      "h": 24,
      "bind": "serial.history_count",
      "prefix": "HISTORY: ",
      "color": "#8B949E"
    },
    {
      "type": "label",
      "x": 386,
      "y": 284,
      "w": 142,
      "h": 24,
      "bind": "serial.rx_bytes",
      "prefix": "RX ",
      "suffix": " B",
      "color": "#8B949E"
    },
    {
      "type": "label",
      "x": 548,
      "y": 284,
      "w": 180,
      "h": 24,
      "bind": "serial.tx_bytes",
      "prefix": "TX ",
      "suffix": " B",
      "color": "#8B949E"
    },
    {
      "type": "keyboard",
      "x": 16,
      "y": 240,
      "w": 712,
      "h": 100,
      "target": "tx_input",
      "action": "serial_send_text",
      "color": "#FFFFFF"
    }
  ]
}
